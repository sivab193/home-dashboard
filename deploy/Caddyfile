:1984 {
	encode zstd gzip

	route {
		@home path /api/home/* /api/media /api/media/* /api/config /api/config/* /api/automations /api/automations/*
		reverse_proxy @home 127.0.0.1:8090

		@alerts path /api/events /api/events/* /api/health /api/health/* /api/snapshots/*
		reverse_proxy @alerts 127.0.0.1:8091

		@streams path /api/streams /api/streams/* /api/ws /api/ws/*
		reverse_proxy @streams 127.0.0.1:1985

		root * {$DASHBOARD_ROOT}
		try_files {path} {path}/ /index.html
		file_server
	}
}
